  <property name="styleSheet">
   <string notr="true">
    QDialog {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    }
    QLabel {
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
    }
    QCheckBox {
        color: #1e293b;
        font-size: 13px;
        spacing: 8px;
    }
    QCheckBox::indicator {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
        background-color: white;
    }
    QCheckBox::indicator:hover {
        border: 1px solid #94a3b8;
    }
    QCheckBox::indicator:checked {
        background-color: #3b82f6;
        border: 1px solid #3b82f6;
        image: none;
    }
    QPushButton {
        background-color: transparent;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #1e293b;
        min-width: 80px;
    }
    QPushButton:hover {
        background-color: #e2e8f0;
    }
    QPushButton:pressed {
        background-color: #cbd5e1;
    }
    QPushButton#save_button {
        background-color: #3b82f6;
        color: white;
    }
    QPushButton#save_button:hover {
        background-color: #2563eb;
    }
    QPushButton#cancel_button {
        background-color: transparent;
        color: #1e293b;
    }
    QPushButton#cancel_button:hover {
        background-color: #fee2e2;
        color: #dc2626;
    }
    QFrame#frame {
        background-color: white;
        border-bottom: 1px solid #e2e8f0;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }
    QWidget#widget_3 {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    QWidget#widget_2 {
        background-color: white;
        border-top: 1px solid #e2e8f0;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
    }
    QScrollBar:vertical {
        background: #f1f5f9;
        width: 10px;
        border-radius: 5px;
        margin: 0px;
    }
    QScrollBar::handle:vertical {
        background: #cbd5e1;
        border-radius: 5px;
        min-height: 30px;
    }
    QScrollBar::handle:vertical:hover {
        background: #94a3b8;
    }
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        border: none;
        background: none;
    }
    QScrollBar:horizontal {
        background: #f1f5f9;
        height: 10px;
        border-radius: 5px;
        margin: 0px;
    }
    QScrollBar::handle:horizontal {
        background: #cbd5e1;
        border-radius: 5px;
        min-width: 30px;
    }
    QScrollBar::handle:horizontal:hover {
        background: #94a3b8;
    }
    QAbstractScrollArea {
        border: none;
        background-color: white;
    }
    QStackedWidget {
        background-color: white;
    }
    QPushButton#nextGroup_button, QPushButton#prevGroup_button {
        background-color: #e2e8f0;
        min-width: 100px;
    }
    QPushButton#nextGroup_button:hover, QPushButton#prevGroup_button:hover {
        background-color: #cbd5e1;
    }
   </string>
