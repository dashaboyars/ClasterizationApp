    }
    QPushButton {
        background-color: transparent;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #1e293b;
        min-width: 80px;
    }
    QPushButton:hover {
        background-color: #e2e8f0;
    }
    QPushButton:pressed {
        background-color: #cbd5e1;
    }
    QPushButton[text="OK"] {
        background-color: #3b82f6;
        color: white;
    }
    QPushButton[text="OK"]:hover {
        background-color: #2563eb;
    }
    QPushButton[text="Cancel"]:hover {
        background-color: #fee2e2;
        color: #dc2626;
    }
    QLineEdit#minSize_text, QLineEdit#maxSize_text, QLineEdit#minResolution_text,
    QLineEdit#minColor_text, QLineEdit#minSharpness_text, QLineEdit#maxNoise_text,
    QLineEdit#minContrast_text {
