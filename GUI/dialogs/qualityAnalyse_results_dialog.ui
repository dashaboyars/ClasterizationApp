        color: #1e293b;
        padding: 8px 20px;
        margin-right: 4px;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        font-weight: 500;
    }
    QTabBar::tab:selected {
        background-color: white;
        border-bottom: 2px solid #3b82f6;
        color: #0f172a;
    }
    QTabBar::tab:hover:!selected {
        background-color: #e2e8f0;
    }
    QTableView {
        background-color: white;
        border: none;
        border-radius: 8px;
        alternate-background-color: #f8fafc;
        selection-background-color: #e0f2fe;
        selection-color: #0f172a;
        gridline-color: #e2e8f0;
        font-size: 12px;
    }
    QHeaderView::section {
        background-color: #f8fafc;
        color: #0f172a;
        padding: 6px;
        border: none;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 600;
    }
    QPushButton {
        background-color: transparent;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #1e293b;
        min-width: 80px;
    }
    QPushButton:hover {
        background-color: #e2e8f0;
    }
    QPushButton:pressed {
        background-color: #cbd5e1;
    }
    QPushButton#btn_acceptChanges {
        background-color: #3b82f6;
        color: white;
    }
    QPushButton#btn_acceptChanges:hover {
