<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Dialog</class>
 <widget class="QDialog" name="Dialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>450</width>
    <height>270</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>450</width>
    <height>240</height>
   </size>
  </property>
  <property name="maximumSize">
   <size>
    <width>600</width>
    <height>300</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Выбор данных для обучения</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QDialog {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    }
    QLabel {
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 8px;
    }
    QComboBox {
        background-color: white;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 13px;
        color: #0f172a;
        min-height: 20px;
        selection-background-color: #3b82f6;
    }
    QComboBox:focus {
        border: 1px solid #3b82f6;
        outline: none;
    }
    QComboBox::drop-down {
        border: none;
        width: 30px;
    }
    QComboBox::down-arrow {
        image: none;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 5px solid #64748b;
        margin-right: 12px;
    }
    QPushButton {
        background-color: transparent;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #1e293b;
        min-width: 80px;
    }
    QPushButton:hover {
        background-color: #e2e8f0;
    }
    QPushButton:pressed {
        background-color: #cbd5e1;
    }
    QPushButton[text=&quot;OK&quot;] {
        background-color: #3b82f6;
        color: white;
    }
    QPushButton[text=&quot;OK&quot;]:hover {
        background-color: #2563eb;
    }
    QPushButton[text=&quot;Cancel&quot;]:hover {
        background-color: #fee2e2;
        color: #dc2626;
    }
    QLabel#warning_label {
        color: #dc2626;
        font-size: 11px;
        font-weight: normal;
        margin-top: 4px;
        background-color: #fff5f5;
        border-radius: 6px;
        padding: 6px;
    }
   </string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <property name="spacing">
    <number>0</number>
   </property>
   <property name="leftMargin">
    <number>9</number>
   </property>
   <item>
    <widget class="QLabel" name="label">
     <property name="text">
      <string>Выберите датасет для обучения модели:</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QComboBox" name="datasets_comboBox"/>
   </item>
   <item>
    <widget class="QLabel" name="label_2">
     <property name="text">
      <string>Выберите эталонную сессию кластеризации / классификации НС</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QComboBox" name="sessions_comboBox"/>
   </item>
   <item>
    <widget class="QLabel" name="warning_label">
     <property name="text">
      <string>⚠️ Обратите внимание: сессия должна содержать 4–5 кластеров с названиями &quot;Нос&quot;, &quot;Ухо&quot;, &quot;Глотка&quot;, &quot;Гортань&quot;, &quot;Другое&quot;</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
     <property name="centerButtons">
      <bool>false</bool>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
